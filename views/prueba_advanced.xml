<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rrhh_upo_prueba_list" model="ir.ui.view">
        <field name="name">rrhh_upo.prueba.list</field>
        <field name="model">rrhh_upo.prueba</field>
        <field name="arch" type="xml">
            <list string="Pruebas"
                  decoration-success="sResultado == 'superada'"
                  decoration-danger="sResultado == 'no_superada'">
                <field name="sNombre"/>
                <field name="inscripcionCurso_id"/>
                <field name="dFechaRealizacion"/>
                <field name="sResultado"/>
            </list>
        </field>
    </record>

    <record id="view_rrhh_upo_prueba_form" model="ir.ui.view">
        <field name="name">rrhh_upo.prueba.form</field>
        <field name="model">rrhh_upo.prueba</field>
        <field name="arch" type="xml">
            <form string="Prueba">
                <header>
                    <field name="sResultado" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="sNombre"/>
                        <h1>
                            <field name="sNombre" placeholder="Nombre de la prueba"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Inscripción">
                            <field name="inscripcionCurso_id"/>
                        </group>
                        <group string="Realización">
                            <field name="dFechaRealizacion"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rrhh_upo_prueba_calendar" model="ir.ui.view">
        <field name="name">rrhh_upo.prueba.calendar</field>
        <field name="model">rrhh_upo.prueba</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de pruebas"
                      date_start="dFechaRealizacion"
                      color="sResultado"
                      mode="month"
                      quick_create="0">
                <field name="sNombre"/>
                <field name="inscripcionCurso_id"/>
                <field name="sResultado"/>
            </calendar>
        </field>
    </record>

    <record id="action_rrhh_upo_prueba" model="ir.actions.act_window">
        <field name="name">Pruebas</field>
        <field name="res_model">rrhh_upo.prueba</field>
        <field name="view_mode">list,form,calendar</field>
    </record>

    <menuitem id="menu_rrhh_upo_prueba" name="Pruebas"
              parent="menu_rrhh_upo_cursos_root"
              action="action_rrhh_upo_prueba" sequence="30"/>

</odoo>