<odoo>
    <record id="rrhh_upo_titulo_academico_list_view" model="ir.ui.view">
        <field name="name">rrhh_upo.titulo_academico.list</field>
        <field name="model">hr.recruitment.degree</field>
        <field name="inherit_id" ref="hr_recruitment.hr_recruitment_degree_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="rama" optional="show"/>
            </field>
        </field>
    </record>

    <record id="rrhh_upo_titulo_academico_form_view" model="ir.ui.view">
        <field name="name">rrhh_upo.titulo_academico.form</field>
        <field name="model">hr.recruitment.degree</field>
        <field name="inherit_id" ref="hr_recruitment.hr_recruitment_degree_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="rama"/>
                <field name="requisito_ids" widget="many2many_tags"/>
            </field>
        </field>
    </record>
</odoo>