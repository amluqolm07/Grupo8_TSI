<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rrhh_upo_ayuda_list" model="ir.ui.view">
        <field name="name">rrhh_upo.ayuda.list</field>
        <field name="model">rrhh_upo.ayuda</field>
        <field name="arch" type="xml">
            <list string="Ayudas">
                <field name="sNombre"/>
                <field name="m2oTipoAyuda"/>
                <field name="m2oAlumno"/>
                <field name="fImporte" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_rrhh_upo_ayuda_form" model="ir.ui.view">
        <field name="name">rrhh_upo.ayuda.form</field>
        <field name="model">rrhh_upo.ayuda</field>
        <field name="arch" type="xml">
            <form string="Ayuda">
                <sheet>
                    <div class="oe_title">
                        <label for="sNombre"/>
                        <h1>
                            <field name="sNombre" placeholder="Nombre de la ayuda"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Datos de la ayuda">
                            <field name="m2oTipoAyuda"/>
                            <field name="fImporte"/>
                        </group>
                        <group string="Solicitud">
                            <field name="m2oAlumno"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Personal que administra">
                            <field name="m2mPersonalRrhh" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rrhh_upo_ayuda" model="ir.actions.act_window">
        <field name="name">Ayudas</field>
        <field name="res_model">rrhh_upo.ayuda</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_rrhh_upo_ayudas_root" name="Ayudas" sequence="50"/>
    <menuitem id="menu_rrhh_upo_ayuda" name="Ayudas"
              parent="menu_rrhh_upo_ayudas_root"
              action="action_rrhh_upo_ayuda" sequence="10"/>

</odoo>