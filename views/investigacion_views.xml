<odoo>
    <record id="rrhh_upo_investigacion_list_view" model="ir.ui.view">
        <field name="name">rrhh_upo.investigacion.list</field>
        <field name="model">rrhh_upo.investigacion</field>
        <field name="arch" type="xml">
            <list string="list_string">
                <field name="name"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <record id="rrhh_upo_investigacion_form_view" model="ir.ui.view">
        <field name="name">rrhh_upo.investigacion.form</field>
        <field name="model">rrhh_upo.investigacion</field>
        <field name="arch" type="xml">
            <form string="form_string">
                <sheet layout="auto">
                    <group>
                        <field name="name"/>
                        <field name="fecha_inicio"/>
                        <field name="fecha_fin"/>
                        <field name="estado"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="investigacion_list_action" model="ir.actions.act_window">
        <field name="name">Investigaciones</field>
        <field name="res_model">rrhh_upo.investigacion</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"> Añade la primera investigacion </p>
        </field>
    </record>
</odoo>