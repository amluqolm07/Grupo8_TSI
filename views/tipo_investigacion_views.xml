<odoo>
    <record id="rrhh_upo_tipo_investigacion_list_view" model="ir.ui.view">
        <field name="name">rrhh_upo.tipo_investigacion.list</field>
        <field name="model">rrhh_upo.tipo_investigacion</field>
        <field name="arch" type="xml">
            <list string="list_string">
                <field name="name"/>
                <field name="descriptor"/>
            </list>
        </field>
    </record>

    <record id="rrhh_upo_tipo_investigacion_form_view" model="ir.ui.view">
        <field name="name">rrhh_upo.tipo_investigacion.form</field>
        <field name="model">rrhh_upo.tipo_investigacion</field>
        <field name="arch" type="xml">
            <form string="form_string">
                <sheet layout="auto">
                    <group>
                        <field name="name"/>
                        <field name="descriptor"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tipo_investigacion_list_action" model="ir.actions.act_window">
        <field name="name">Tipos de Investigación</field>
        <field name="res_model">rrhh_upo.tipo_investigacion</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"> Añade el primer tipo de investigación </p>
        </field>
    </record>
</odoo>