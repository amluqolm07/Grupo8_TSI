<odoo>

    <!-- Solicitud List View -->
    <record id="rrhh_upo_solicitud_list_view" model="ir.ui.view">
        <field name="name">rrhh_upo.solicitud.list</field>
        <field name="model">rrhh_upo.solicitud</field>
        <field name="arch" type="xml">
            <list string="list_string">
                <!-- <field name="persona_id"/> 
                <field name="oferta_empleo_id"/> -->
                <field name="name"/>
                <field name="concepto"/>
                <field name="estado"/>
                <field name="cv"/>
            </list>
        </field>
    </record>





    <record id="rrhh_upo_solicitud_form_view" model="ir.ui.view">
        <field name="name">rrhh_upo.solicitud.form</field>
        <field name="model">rrhh_upo.solicitud</field>
        <field name="arch" type="xml">
            <form string="form_string">
                <header>
                    <button name="btn_submit_to_pendiente" type="object" string="Pendiente" class="oe_highlight" />
                    <button name="btn_submit_to_aprobada" type="object" string="Aprobado" class="oe_highlight"/>
                    <button name="btn_submit_to_rechazada" type="object" string="Rechazado" class="oe_highlight"/>
                </header>

                <sheet layout="auto">
                    <group>
                        <field name="name"/>
                        <field name="concepto"/>
                        <field name="cv"/>
                        <field name="estado" widget="statusbar"/>
                        <!-- <field name="persona_id"/> 
                        <field name="oferta_empleo_id"/> 
                        <field name="stand_id"/> -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>








    <record id="solicitud_list_action" model="ir.actions.act_window">
        <field name="name">Solicitudes</field>
        <field name="res_model">rrhh_upo.solicitud</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"> Añade la primera solicitud </p>
        </field>
    </record>
</odoo>