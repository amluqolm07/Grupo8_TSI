<odoo>
    <record id="rrhh_upo_aptitud_form_view" model="ir.ui.view">
        <field name="name">hr_skill.rrhh_upo.form</field>
        <field name="model">hr.skill</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <field name="skill_type_id"/>
                    </group>
                    <group string="Descripción">
                        <field name="descripcion" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Usado en requisitos" name="requisitos">
                            <field name="requisito_ids" widget="many2many_tags" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rrhh_upo_aptitud_list_view" model="ir.ui.view">
        <field name="name">hr.skill.rrhh_upo.list</field>
        <field name="model">hr.skill</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="skill_type_id"/>
            </list>
        </field>
    </record>

    <record id="aptitud_list_action" model="ir.actions.act_window">
        <field name="name">Aptitudes</field>
        <field name="res_model">hr.skill</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first aptitud</p>
        </field>
    </record>
</odoo>