<odoo>
    <record id="rrhh_upo_matricula_list_view" model="ir.ui.view">
        <field name="name">rrhh_upo.matricula.list</field>
        <field name="model">rrhh_upo.matricula</field>
        <field name="arch" type="xml">
            <list string="list_string">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="rrhh_upo_matricula_form_view" model="ir.ui.view">
        <field name="name">rrhh_upo.matricula.form</field>
        <field name="model">rrhh_upo.matricula</field>
        <field name="arch" type="xml">
            <form string="form_string">
                <sheet layout="auto">
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="matricula_list_action" model="ir.actions.act_windows">
        <field name="name">Matriculas</field>
        <field name="res_model">rrhh_upo.matricula</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"> Añade la primera matricula </p>
        </field>
    </record>
</odoo>