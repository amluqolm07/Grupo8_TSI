<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_rrhh_upo_encuesta_list" model="ir.ui.view">
        <field name="name">rrhh_upo.encuesta.list</field>
        <field name="model">rrhh_upo.encuesta</field>
        <field name="arch" type="xml">
            <list string="Encuestas">
                <field name="alumno_id"/>
                <field name="pdi_id"/>
                <field name="sCursoAcademico"/>
                <field name="iResultado" avg="Media"/>
            </list>
        </field>
    </record>

    <record id="view_rrhh_upo_encuesta_form" model="ir.ui.view">
        <field name="name">rrhh_upo.encuesta.form</field>
        <field name="model">rrhh_upo.encuesta</field>
        <field name="arch" type="xml">
            <form string="Encuesta">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Valoración">
                            <field name="alumno_id"/>
                            <field name="pdi_id"/>
                        </group>
                        <group string="Resultado">
                            <field name="sCursoAcademico"/>
                            <field name="iResultado"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rrhh_upo_encuesta" model="ir.actions.act_window">
        <field name="name">Encuestas</field>
        <field name="res_model">rrhh_upo.encuesta</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_rrhh_upo_encuestas_root" name="Encuestas" sequence="60"/>
    <menuitem id="menu_rrhh_upo_encuesta" name="Encuestas"
              parent="menu_rrhh_upo_encuestas_root"
              action="action_rrhh_upo_encuesta" sequence="10"/>

</odoo>