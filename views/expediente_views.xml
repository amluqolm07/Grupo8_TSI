<odoo>
    <!-- List View -->
    <record id="rrhh_upo_expediente_list_view" model="ir.ui.view">
        <field name="name">rrhh_upo.expediente.list</field>
        <field name="model">rrhh_upo.expediente</field>
        <field name="arch" type="xml">
            <list string="list_string">
                <field name="name"/>
                <field name="fecha_fin"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="rrhh_upo_expediente_form_view" model="ir.ui.view">
        <field name="name">rrhh_upo.expediente.form</field>
        <field name="model">rrhh_upo.expediente</field>
        <field name="arch" type="xml">
            <form string="form_string">
                <header>
                    <button name="btn_submit_to_abierto" type="object" string="Abierto" class="oe_highlight"/>
                    <button name="btn_submit_to_cerrado" type="object" string="Cerrado" class="oe_highlight"/>
                <sheet layout="auto">
                    <group>
                        <field name="name"/>
                        <field name="fecha_fin"/>
                        <field name="estado"/>
                        <!-- <field name="alumno_id" widget="many2one"/> -->
                        <field name="grado_id" widget="many2one"/>
                    </group>
                    <group>
                        <field name="nota_media"/>
                        <field name="creditos_matriculados"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Graph View -->
    <record id="rrhh_upo_expediente_graph_view" model="ir.ui.view">
        <field name="name">rrhh_upo.expediente.graph</field>
        <field name="model">rrhh_upo.expediente</field>
        <field name="arch" type="xml">
            <graph string="Nota media por grado" type="bar">
                <field name="grado_id" type="row"/>
                <field name="nota_media" type="measure"/>
            </graph>
        </field>
    </record>


    <record id="expediente_list_action" model="ir.actions.act_window">
        <field name="name">Expedientes</field>
        <field name="res_model">rrhh_upo.expediente</field>
        <field name="view_mode">list,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"> Añade un expediente </p>
        </field>
    </record>
</odoo>