<odoo>
    <record id="rrhh_upo_equipo_investigacion_list_view" model="ir.ui.view">
        <field name="name">rrhh_upo.equipo_investigacion.list</field>
        <field name="model">rrhh_upo.equipo_investigacion</field>
        <field name="arch" type="xml">
            <list string="list_string">
                <field name="name"/>
                <field name="especialidad"/>
            </list>
        </field>
    </record>

    <record id="rrhh_upo_equipo_investigacion_form_view" model="ir.ui.view">
        <field name="name">rrhh_upo.equipo_investigacion.form</field>
        <field name="model">rrhh_upo.equipo_investigacion</field>
        <field name="arch" type="xml">
            <form string="form_string">
                <sheet layout="auto">
                    <group>
                        <field name="name"/>
                        <field name="especialidad"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="equipo_investigacion_list_action" model="ir.actions.act_windows">
        <field name="name">Equipos de Investigación</field>
        <field name="res_model">rrhh_upo.equipo_investigacion</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"> Añade el primer equipo de investigación </p>
        </field>
    </record>
</odoo>