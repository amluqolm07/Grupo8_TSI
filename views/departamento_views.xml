<odoo>
    <record id="rrhh_upo_departamento_list_view" model="ir.ui.view">
        <field name="name">rrhh_upo.departamento.list</field>
        <field name="model">rrhh_upo.departamento</field>
        <field name="arch" type="xml">
            <list string="list_string">
                <field name="name"/>
                <field name="email"/>
                <field name="planta"/>
                <field name="grado_id widget=many2one"/>
                <field name="equipo_investigacion_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="rrhh_upo_departamento_form_view" model="ir.ui.view">
        <field name="name">rrhh_upo.departamento.form</field>
        <field name="model">rrhh_upo.departamento</field>
        <field name="arch" type="xml">
            <form string="form_string">
                <sheet layout="auto">
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="planta"/>
                        <field name="grado_id widget=many2one"/>
                        <field name="equipo_investigacion_ids" widget="many2many_tags"/>
                        <!-- <field name="telefono_ids" widget="many2many_tags"/>
                        <fields name="edificio_id" widget="many2one"/> -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="departamento_list_action" model="ir.actions.act_window">
        <field name="name">Departamentos</field>
        <field name="res_model">rrhh_upo.departamento</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"> Añade el primer departamento </p>
        </field>
    </record>
</odoo>