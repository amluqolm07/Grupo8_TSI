<odoo>
    <record id="rrhh_upo_material_form_view" model="ir.ui.view">
        <field name="name">rrhh_upo.material.form</field>
        <field name="model">rrhh_upo.material</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="cantidad"/>
                    </group>
                    <group string="Especificaciones">
                        <field name="descriptor" nolabel="1"
                            placeholder="Características técnicas, instrucciones y condiciones de entrega..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rrhh_upo_material_list_view" model="ir.ui.view">
        <field name="name">rrhh_upo.material.list</field>
        <field name="model">rrhh_upo.material</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="cantidad"/>
            </list>
        </field>
    </record>

        <record id="material_list_action" model="ir.actions.act_window">
        <field name="name">Materiales</field>
        <field name="res_model">rrhh_upo.material</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first material</p>
        </field>
    </record>
</odoo>